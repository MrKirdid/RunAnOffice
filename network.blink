--https://1axen.github.io/blink

option ClientOutput = "src/Shared/Networking/networkingClient.luau"
option ServerOutput = "src/Shared/Networking/networkingServer.luau"
option TypesOutput = "src/Shared/Networking/networkingTypes.luau"

option PromiseLibrary = "ReplicatedStorage.Shared.Packages.TypedPromise"
option Casing = Pascal

type Player = Instance(Player)

function Roll {
	Yield: Promise,
	-- how many rolls the client thinks it's making, the server checks it against RollsUnlocked
	Data: u8(1..17),
	Return: struct {
		Player: Player,
		-- [slot 0-16]: the single component that pad rolled, and the variant it landed on
		Results: map { [u8(0..16)]: struct {
			Component: string(1..20),
			Variant: string(1..20)
		} }
	}
}

scope Plot {
	function GetPlots {
		Yield: Promise,
		Return: map { [Player]: u8(0..8) }
	}

	event UpdatePlots {
		From: Server,
		Type: Reliable,
		Call: SingleAsync,
		Data: map { [Player]: u8(0..8) }
	}
}

scope Items {
	-- which pad to take from. The server put the parts there, so the slot is all it needs
	-- from the client and the client cannot name a part it did not roll.
	function PickUp {
		Yield: Promise,
		Data: u8(0..16),
		Return: struct {
			Component: string(1..20),
			Variant: string(1..20)
		}
	}

	-- the desk to drop what is in hand onto. Which component it lands in is decided by what the
	-- player is holding, which is server side, so it is not a thing the client gets to pick.
	function Replace {
		Yield: Promise,
		Data: struct {
			Floor: u8(1..16),
			Slot: u8(1..16)
		},
		Return: struct {
			Component: string(1..20),
			Variant: string(1..20)
		}
	}
}

scope Stealing {

}

scope Purchases {
	event BuyDesk {
		From: Client,
		Type: Reliable,
		Call: SingleAsync,
	}
}

scope Employees {
	type UID = u32
	type Position = vector

	-- one employee walking the map. Cost rides along rather than being looked up client side
	-- so the prompt prints what the server will actually charge.
	struct Spawn {
		UID: UID,
		Name: string(1..20),
		Type: string(1..20),
		Cost: u32,
		Position: Position,
		Owner: Player?
	}

	struct Move {
		UID: UID,
		Position: Position
	}

	struct Ownership {
		UID: UID,
		Owner: Player?
	}

	-- everyone already walking when the client joined, so a late joiner is not left with an
	-- empty map until the next spawn tick.
	function GetAll {
		Yield: Promise,
		Return: Spawn[0..255]
	}

	-- the one to redirect at a free desk. The buyer is the caller and the seat is picked
	-- server side, so the client only ever names which employee it wants.
	function Buy {
		Yield: Promise,
		Data: UID,
		Return: boolean
	}

	event Added {
		From: Server,
		Type: Reliable,
		Call: SingleAsync,
		Data: Spawn[0..255]
	}

	-- unreliable because a dropped step is corrected by the next one a tenth of a second later,
	-- and the client interpolates between whatever it has.
	event Moved {
		From: Server,
		Type: Unreliable,
		Call: SingleAsync,
		Data: struct {
			UID: UID,
			Position: Position
		}[0..255]
	}

	event Removed {
		From: Server,
		Type: Reliable,
		Call: SingleAsync,
		Data: UID[0..255]
	}

	event OwnerChanged {
		From: Server,
		Type: Reliable,
		Call: SingleAsync,
		Data: struct {
			UID: UID,
			Owner: Player?
		}[0..255]
	}
}
